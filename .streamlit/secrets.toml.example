# Copy this file to secrets.toml and fill in your credentials
# 把本文件另存为 .streamlit/secrets.toml 再填值
#
# ================================================================
# 根据你实际使用的组合，参考下面三个典型配置之一
# ================================================================

# ──────────────────────────────────────────────────────────────────
# 组合 A ·「多中转 Claude + Gemini 辅助」（最常见、可一键切换）
# ──────────────────────────────────────────────────────────────────
# 定义多个 [claude_relay_presets.xxx] 段，然后用 ACTIVE_CLAUDE_RELAY
# 指定默认启动哪个。系统启动后可以在 Settings 页面一键切换，不用改 secrets。

ACTIVE_CLAUDE_RELAY = "new_relay"

[claude_relay_presets.new_relay]
label = "新中转站（RPM 15，全功能）"
api_key = "sk-ant-..."
base_url = ""                          # 中转 URL；直连官方留空
rpm_limit = 15                         # 60 秒内最多启动几次调用
max_concurrent = 16                    # 同时在飞最多几条
supports_cache = true                  # cache_control: ephemeral 是否生效
supports_adaptive_thinking = true      # 是否支持 `thinking.type=adaptive`（4.6+ 首选）

[claude_relay_presets.old_relay]
label = "旧中转站（RPM 60，固定 budget_tokens）"
api_key = "sk-ant-old-..."
base_url = "https://old-relay.com"
rpm_limit = 60
max_concurrent = 10
# supports_cache 不填就默认 true——试试总没坏处：不支持的中转会静默忽略
# cache_control 字段（不报错不扣费，只是多几十 bytes 的 JSON），命中了就省钱。
# 只有**明确看到中转返回 400 "unsupported field: cache_control"** 时才填 false。
# 系统也有自动兜底：真的触发 400 会自动禁用 cache_control 重试一次。
supports_cache = true
supports_adaptive_thinking = false     # 回退到 {"type":"enabled","budget_tokens":N}

# 公共项
VERTEX_EXPRESS_API_KEY = "AIzaSy..."        # Gemini 辅助，可选
SUPABASE_URL = "https://xxx.supabase.co"
SUPABASE_KEY = "eyJ..."


# ──────────────────────────────────────────────────────────────────
# 组合 B ·「全走 Vertex：Claude on Vertex + Gemini on Vertex」
# ──────────────────────────────────────────────────────────────────
# 若你希望 Claude 也走 Vertex（取消中转站），用 Service Account 模式。
# 注意：填了 GCP_PROJECT_ID 就会走 Vertex，上面的 claude_relay_presets
# 段会被忽略。
#
# GCP_PROJECT_ID = "your-project-id"
# GCP_REGION = "asia-southeast1"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "从 JSON 复制"
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "xxx@your-project-id.iam.gserviceaccount.com"
# client_id = "从 JSON 复制"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "从 JSON 复制"
#
# VERTEX_EXPRESS_API_KEY = "AIzaSy..."
# SUPABASE_URL = "https://xxx.supabase.co"
# SUPABASE_KEY = "eyJ..."


# ──────────────────────────────────────────────────────────────────
# 组合 C ·「只用单个中转 Claude，不用 Gemini」(向后兼容最简配置)
# ──────────────────────────────────────────────────────────────────
# 如果你只有一个中转站、不需要一键切换，也不想填多 preset 段，
# 可以用最老的顶层字段形式——系统会自动把它们包成一个名叫 "default"
# 的 preset，显示在 Settings 页上（但没别的 preset 可切）：
#
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_BASE_URL = ""
# SUPABASE_URL = "https://xxx.supabase.co"
# SUPABASE_KEY = "eyJ..."
#
# 推荐升级到组合 A（多 preset）以便将来换中转无痛。
