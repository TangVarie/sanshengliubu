# Copy this file to secrets.toml and fill in your credentials
# 系统自动检测：有 GCP_PROJECT_ID → Vertex AI，没有 → 中转站/直连

# ──────────────────────────────────────────────────────────────
# 方式一：Vertex AI（推荐，无截断限制）
# ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID = "gen-lang-client-0945340354"
GCP_REGION = "asia-southeast1"

# Service Account 凭证（Streamlit Cloud 部署必须填）
# 从 GCP Console → IAM → Service Accounts → 创建 key → JSON
# 把 JSON 文件内容拆成下面的 TOML section
[gcp_service_account]
type = "service_account"
project_id = "gen-lang-client-0945340354"
private_key_id = "从 JSON 复制"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "xxx@gen-lang-client-0945340354.iam.gserviceaccount.com"
client_id = "从 JSON 复制"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "从 JSON 复制"

# ──────────────────────────────────────────────────────────────
# 方式二：直连 Anthropic / 中转站
# 如果填了 GCP_PROJECT_ID，下面这两行会被忽略
# ──────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_BASE_URL = ""

# ──────────────────────────────────────────────────────────────
# Gemini 辅助检查（可选，独立于 Claude 接入）
# ──────────────────────────────────────────────────────────────
# 当配了 VERTEX_EXPRESS_API_KEY 且 pipeline/config.py 里
# ENABLE_GEMINI_ASSIST=True 时，Gemini 会作为:
#   1. 网感二次审：Claude critic 判 pass 的 cell 由 Gemini 复核
#   2. 结构审：工部构建后，审查每条 prompt_cell 的 5 池 / 人设 / 合规完整性
# Gemini 失败时 advisory 退回，不阻塞流水线。
#
# 从 GCP Console → Vertex AI → Settings → API keys 生成（Vertex Express）
# VERTEX_EXPRESS_API_KEY = "AIzaSy..."

# ──────────────────────────────────────────────────────────────
# Supabase（两种模式都需要）
# ──────────────────────────────────────────────────────────────
SUPABASE_URL = "https://xxx.supabase.co"
SUPABASE_KEY = "eyJ..."
