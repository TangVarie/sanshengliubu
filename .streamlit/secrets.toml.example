# Copy this file to secrets.toml and fill in your credentials
# 把本文件另存为 .streamlit/secrets.toml 再填值
#
# ================================================================
# v0.32.0 起主链路只用两家：Kimi (Moonshot) + DeepSeek
# ================================================================
# 想快点跑起来，只看下面的「标准配置」就够了。
# 后面的「历史配置」几段是给还没迁完的老部署留的，新装可以整段忽略。


# ──────────────────────────────────────────────────────────────────
# 标准配置（v0.32.0 默认，照抄即可）
# ──────────────────────────────────────────────────────────────────

# ── Kimi / Moonshot —— 主链路的大头 ───────────────────────────────
# 24 个 stage 里 20 个跑 Kimi：策略核心 4 个走 kimi-k3，其余走 kimi-k2.6。
# 辅助层（识图 / 截图分析 / 结构审）也用这个 key。没有它整条流水线跑不起来。
#
# ⚠️ 国内站和国际站是两套独立账号体系，key 不通用，别混：
#     platform.moonshot.cn 的 key → MOONSHOT_BASE_URL 用 api.moonshot.cn
#     platform.moonshot.ai 的 key → MOONSHOT_BASE_URL 用 api.moonshot.ai
#   配错了会报 401/404，且报错文案不一定指向"站点搞错了"这个真实原因。
MOONSHOT_API_KEY = "sk-..."
# 不填默认 https://api.moonshot.cn/anthropic（国内站）。
# 部署在 Streamlit Cloud（美国机房）且用的是国际站 key，就改成
# https://api.moonshot.ai/anthropic —— 延迟低不少。
# MOONSHOT_BASE_URL = "https://api.moonshot.ai/anthropic"

# ── DeepSeek —— 跨厂家对抗 + 廉价批量 ─────────────────────────────
# 门下省(critic)/兵部(刁钻竞争)/红蓝守方/画像模拟·alt/网感二审 走这里。
# 这些位置故意跟 Kimi 用不同厂家：辩论双方同色彩就成了自言自语。
# 没配的话这几个 stage 会按 MODEL_FALLBACK_CHAIN 降级到 Kimi 继续跑完，
# 但对抗性会打折。
DEEPSEEK_API_KEY = "sk-..."
# 不填默认 https://api.deepseek.com/anthropic
# DEEPSEEK_BASE_URL = "https://api.deepseek.com/anthropic"

# ── SocialDataX —— 趋势取样 + 参考帖抓取 ──────────────────────────
# 两个用途：
#   1. 趋势取样(PRE)：跑策略前抓真实小红书爆款当校准样本。默认 REQUIRED，
#      取不到样会直接终止 run（少了关键素材硬跑只会产出废案）。
#   2. 参考帖抓取：把用户在第 2 页粘贴的对标帖 URL 取成结构化正文。
#      advisory，失败只跳过。
# 申请：https://socialdatax.com/?from=npm
SOCIALDATAX_API_KEY = "..."

# ── Supabase —— 数据存储 ──────────────────────────────────────────
SUPABASE_URL = "https://xxx.supabase.co"
SUPABASE_KEY = "eyJ..."


# ==================================================================
# 以下都是历史配置，v0.32.0 的默认路径【不需要】
# ==================================================================
# 留着是因为：(a) 老部署迁移期间可能还在用；(b) 代码里那几条 backend 都还
# 在，你可以用 model_overrides 把个别 stage 钉回去做 A/B。
# 全新安装的话，下面整段删掉都行。

# ── 已停用：Gemini 辅助层 ─────────────────────────────────────────
# v0.32.0 辅助层整体迁到 Kimi，google-genai 依赖已从 requirements 移除。
# 这个 key 现在没有任何代码读它，可以从 secrets.toml 里删掉。
# VERTEX_EXPRESS_API_KEY = "AIzaSy..."

# ── 已停用：GPT via vectorengine ──────────────────────────────────
# v0.31 里门下省/兵部跑 gpt-5.5，v0.32.0 改成 deepseek-v4-flash。
# _call_openai_chat 那条 backend 还在，配了这个 key 之后可以用
# model_overrides 把某个 stage 钉回 gpt-*。默认路径用不到。
# VECTORENGINE_API_KEY = "sk-..."
# VECTORENGINE_BASE_URL = "https://api.vectorengine.ai/v1"

# ── 已停用：Claude 中转 preset ────────────────────────────────────
# v0.32.0 起没有任何 stage 默认指向 claude-*，这几段可以整个删掉。
# 系统在【没有】任何 claude_relay_presets 时也能正常启动（只要
# MOONSHOT_API_KEY / DEEPSEEK_API_KEY 至少有一个）。
#
# 还想保留 Claude 做对照的话：留着 preset，再用 model_overrides 逐 stage
# 指定 claude-* 模型名即可。
#
# ACTIVE_CLAUDE_RELAY = "new_relay"
#
# [claude_relay_presets.new_relay]
# label = "中转站（RPM 15，全功能）"
# api_key = "sk-ant-..."
# base_url = ""                          # 中转 URL；直连官方留空
# rpm_limit = 15                         # 60 秒内最多启动几次调用
# max_concurrent = 16                    # 同时在飞最多几条
# supports_cache = true                  # cache_control: ephemeral 是否生效
# supports_adaptive_thinking = true      # 是否支持 `thinking.type=adaptive`
#
# [claude_relay_presets.new_relay.model_overrides]
# # 逐 stage 覆盖 pipeline/config.py 里 MODELS 的默认值。
# # ⚠️ 这个表对【所有】模型生效，不只是 Claude —— 想临时把某个 stage 从
# #    k2.6 提到 k3、或者降到 deepseek 做成本实验，也是改这里。
# # secretariat = "kimi-k3"
# # vibe_rewriter = "deepseek-v4-flash"

# ── 已停用：Claude on Vertex ──────────────────────────────────────
# 填了 GCP_PROJECT_ID 就会进 Vertex 模式。注意 Vertex 只能跑 Claude，
# kimi-* / deepseek-* 仍然走各自的独立端点（不受 Vertex 模式影响）。
#
# GCP_PROJECT_ID = "your-project-id"
# GCP_REGION = "asia-southeast1"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "从 JSON 复制"
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "xxx@your-project-id.iam.gserviceaccount.com"
# client_id = "从 JSON 复制"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "从 JSON 复制"
