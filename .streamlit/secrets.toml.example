# Copy this file to secrets.toml and fill in your credentials
# 把本文件另存为 .streamlit/secrets.toml 再填值
#
# ================================================================
# 根据你实际使用的组合，参考下面三个典型配置之一
# ================================================================

# ──────────────────────────────────────────────────────────────────
# 组合 A ·「中转站 Claude + Gemini 辅助」（最常见、最简单）
# ──────────────────────────────────────────────────────────────────
# 只填这 5 行，全部放在最顶层，不要套进任何 [...] 块里：

ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_BASE_URL = ""                     # 中转站填其 base URL；直连官方留空
VERTEX_EXPRESS_API_KEY = "AIzaSy..."        # GCP → Vertex AI → Settings → API keys 生成
SUPABASE_URL = "https://xxx.supabase.co"
SUPABASE_KEY = "eyJ..."

# 不要写 GCP_PROJECT_ID / [gcp_service_account]，不然系统会把 Claude 也往
# Vertex 上拉。VERTEX_EXPRESS_API_KEY 是独立的 Gemini-only 通道，不影响 Claude。


# ──────────────────────────────────────────────────────────────────
# 组合 B ·「全走 Vertex：Claude on Vertex + Gemini on Vertex」
# ──────────────────────────────────────────────────────────────────
# 若你希望 Claude 也走 Vertex（取消中转站），用 Service Account 模式：
#
# GCP_PROJECT_ID = "your-project-id"
# GCP_REGION = "asia-southeast1"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "从 JSON 复制"
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "xxx@your-project-id.iam.gserviceaccount.com"
# client_id = "从 JSON 复制"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "从 JSON 复制"
#
# VERTEX_EXPRESS_API_KEY = "AIzaSy..."   # Gemini 仍用 Express API key 最省事
# SUPABASE_URL = "https://xxx.supabase.co"
# SUPABASE_KEY = "eyJ..."


# ──────────────────────────────────────────────────────────────────
# 组合 C ·「只用 Claude，不用 Gemini」
# ──────────────────────────────────────────────────────────────────
# 只填:
#
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_BASE_URL = ""
# SUPABASE_URL = "https://xxx.supabase.co"
# SUPABASE_KEY = "eyJ..."
#
# 也可以在 pipeline/config.py 里把 ENABLE_GEMINI_ASSIST 改成 False 彻底关掉
# （不关也行，未填 VERTEX_EXPRESS_API_KEY 时 Gemini 会自动降级为 skipped）。
