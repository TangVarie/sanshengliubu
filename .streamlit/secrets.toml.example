# Copy this file to secrets.toml and fill in your credentials

# ──────────────────────────────────────────────────────────────
# 方式一：Vertex AI（推荐，无截断限制）
# 需要先 gcloud auth application-default login 或配置 Service Account
# ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID = "your-gcp-project-id"
GCP_REGION = "us-east5"

# ──────────────────────────────────────────────────────────────
# 方式二：直连 Anthropic / 中转站
# 如果填了 GCP_PROJECT_ID，下面这两行会被忽略
# ──────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_BASE_URL = ""

# ──────────────────────────────────────────────────────────────
# Supabase（两种模式都需要）
# ──────────────────────────────────────────────────────────────
SUPABASE_URL = "https://xxx.supabase.co"
SUPABASE_KEY = "eyJ..."
